{
  "window": {
    "selection": "#88c0d0",
    "theme": "Nord Dark"
  },
  "font": {
    "face": "Lilex",
    "features": {},
    "size": 11,
    "weight": 400,
    "lineHeight": 1.2
  },
  "cursor": {
    "shape": "underline",
    "color": "#90ee90",
    "blinking": "on"
  },
  "scroll": {
    "scrollMultiplier": 3.0,
    "maxScrollHistory": 10000,
    "alternateScroll": "on"
  },
  "tabs": [
    {
      "name": "Shell",
      "icon": "",
      "shell": "$SHELL",
      "home": "~"
    }
  ],
  "keys": {
    "ctrl-insert": "Copy",
    "ctrl-shift-c": "Copy",
    "shift-insert": "Paste",
    "ctrl-v": "Paste",
    "ctrl-n": "New",
    "ctrl-shift-1": "New",
    "alt-f4": "Quit"
  }
}
