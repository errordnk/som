{
  "env": {},
  "bell": "off",
  "copyOnSelect": true,
  "theme": "Nord Dark",
  "log": {
    "level": "trace",
    "days": 7
  },
  "font": {
    "face": "FiraCode Nerd Font",
    "features": {},
    "size": 13,
    "weight": "normal",
    "lineHeight": 1.2
  },
  "cursor": {
    "shape": "underline",
    "color": "#90ee90",
    "blinking": "on"
  },
  "scroll": {
    "scrollMultiplier": 3.0,
    "maxScrollHistory": 10000,
    "alternateScroll": "on"
  },
  "tabs": [
    {
      "name": "Shell",
      "icon": "",
      "shell": "$SHELL",
      "workingDir": "~"
    }
  ],
  "keys": {
    "ctrl-insert": "Copy",
    "ctrl-shift-c": "Copy",
    "shift-insert": "Paste",
    "ctrl-v": "Paste",
    "ctrl-n": "New",
    "ctrl-shift-1": "New",
    "ctrl-=": "FontIncrease",
    "ctrl-+": "FontIncrease",
    "ctrl--": "FontDecrease",
    "ctrl-0": "FontReset",
    "alt-f4": "Quit"
  }
}