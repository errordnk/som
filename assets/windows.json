{
  "ui_font_family": "Segoe UI",
  "ui_font_size": 13,
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_size": 11,
  "buffer_font_features": {
    "cv02": true,
    "cv14": true,
    "cv25": true,
    "cv26": true,
    "cv28": true,
    "cv32": true,
    "ss02": true,
    "ss03": true,
    "ss05": true,
    "ss07": true,
    "ss09": true
  },
  "theme": {
    "mode": "dark",
    "light": "Nord Light",
    "dark": "Nord Dark"
  },
  "terminal": {
    "cursor_shape": "underline",
    "cursor_blink": true,
    "line_height": { "custom": 1.2 },
    "max_scroll_history_lines": 9999999
  },
  "tabs": [
    { "name": "PowerShell", "icon": "", "shell": "pwsh.exe" }
  ]
}
