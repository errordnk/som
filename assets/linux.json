{
  "window": {
    "selection": "#88c0d0",
    "theme": "Nord Dark"
  },
  "font": {
    "face": "FiraCode Nerd Font",
    "features": {},
    "size": 11,
    "weight": 400,
    "lineHeight": 1.2
  },
  "cursor": {
    "shape": "underline",
    "color": "#90ee90",
    "blinking": "on"
  },
  "scroll": {
    "scrollMultiplier": 3.0,
    "maxScrollHistory": 10000,
    "alternateScroll": "on"
  },
  "tabs": [
    {
      "name": "Shell",
      "icon": "",
      "shell": "$SHELL",
      "home": "~"
    }
  ],
  "keys": {
    "alt-f4": "Quit",
    "ctrl-insert": "Copy",
    "ctrl-shift-c": "Copy",
    "shift-insert": "Paste",
    "ctrl-v": "Paste",
    "ctrl-=": "IncreaseFont",
    "ctrl--": "DecreaseFont",
    "ctrl-0": "ResetFont",
    "ctrl-shift-=": "NewTab",
    "ctrl-shift-1": "NewTab1",
    "ctrl-shift-2": "NewTab2",
    "ctrl-shift-3": "NewTab3",
    "ctrl-shift-4": "NewTab4",
    "ctrl-shift-5": "NewTab5",
    "ctrl-shift-6": "NewTab6",
    "ctrl-shift-7": "NewTab7",
    "ctrl-shift-8": "NewTab8",
    "ctrl-shift-9": "NewTab9",
    "ctrl-shift-0": "NewTab10",
    "ctrl-shift--": "CloseTab",
    "ctrl-shift-\\": "NewPane",
    "ctrl-shift-backspace": "ClosePane",
    "ctrl-shift-up": "PrevPane",
    "ctrl-shift-down": "NextPane",
    "ctrl-shift-left": "PrevTab",
    "ctrl-shift-right": "NextTab"
  }
}
