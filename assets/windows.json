{
  "env": {},
  "general": {
    "bell": "off",
    "copyOnSelect": true
  },
  "window": {
    "theme": "Nord Dark",
    "mode": "Maximized",
    "padding": {
      "top": 0,
      "bottom": 0,
      "left": 0,
      "right": 0
    },
    "opacity": 1.0
  },
  "log": {
    "level": "trace",
    "days": 7
  },
  "font": {
    "face": "FiraCode Nerd Font",
    "features": {},
    "size": 13,
    "weight": "normal",
    "lineHeight": 1.2
  },
  "cursor": {
    "shape": "underline",
    "color": "#90ee90",
    "blinking": "on"
  },
  "scroll": {
    "scrollMultiplier": 3.0,
    "maxScrollHistory": 10000,
    "alternateScroll": "on"
  },
  "tabs": [
    {
      "name": "shell",
      "icon": "",
      "shell": "$SHELL",
      "workingDir": "~"
    }
  ],
  "keys": {
    "ctrl-insert": "Copy",
    "ctrl-shift-c": "Copy",
    "shift-insert": "Paste",
    "ctrl-v": "Paste",
    "ctrl-n": "New",
    "ctrl-shift-1": "New1",
    "ctrl-shift-2": "New2",
    "ctrl-shift-3": "New3",
    "ctrl-shift-4": "New4",
    "ctrl-shift-5": "New5",
    "ctrl-shift-6": "New6",
    "ctrl-shift-7": "New7",
    "ctrl-shift-8": "New8",
    "ctrl-shift-9": "New9",
    "ctrl-=": "FontIncrease",
    "ctrl--": "FontDecrease",
    "ctrl-0": "FontReset",
    "ctrl-f4": "CloseTab",
    "ctrl-\\": "SplitTab",
    "ctrl-shift-\\": "ClosePane",
    "ctrl-left": "PrevPane",
    "ctrl-right": "NextPane",
    "ctrl-shift-left": "PrevTab",
    "ctrl-shift-right": "NextTab",
    "alt-f4": "Quit"
  }
}
